				channel@21 {
					phandle = <0x147>;
					reg = <0x15>;
					sprd,size-rxbuf = <0x20000>;
					sprd,ringnr = <0x01>;
					compatible = "sprd,spipe";
					label = "sdiag_lte";
					sprd,size-txbuf = <0x8000>;
				};

				route@0 {
					sprd,ul-pool = <0x800>;
					sprd,ul-ack-pool = <0x400>;
					phandle = <0xa2>;
					reg = <0x00>;
					compatible = "sprd,sipx";
					label = "sipx_lte";
					sprd,dl-ack-pool = <0x40>;
					sprd,dl-pool = <0x800>;
