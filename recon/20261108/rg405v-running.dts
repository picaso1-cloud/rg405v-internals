				};

				channel@3 {
					sprd,tx-blknum = <0x40>;
					phandle = <0x144>;
					reg = <0x03>;
					sprd,rx-blknum = <0x40>;
					compatible = "sprd,spool";
					sprd,tx-blksize = <0x80>;
