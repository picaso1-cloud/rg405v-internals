		autotest {
			phandle = <0x168>;
			compatible = "sprd,autotest";
			sprd,pinctrl = <0xb4>;
		};

		reserved-memory {
			phandle = <0x16c>;
			ranges;
			#size-cells = <0x02>;
			#address-cells = <0x02>;

			sml-mem@94000000 {
				phandle = <0x172>;
				reg = <0x00 0x94000000 0x00 0x40000>;
			};

			sysdump-uboot@9f000000 {
				phandle = <0x175>;
				reg = <0x00 0x9f000000 0x00 0x00>;
			};

			ramoops@fff80000 {
				phandle = <0x177>;
				reg = <0x00 0xfff80000 0x00 0x40000>;
				console-size = <0x8000>;
				compatible = "ramoops";
				pmsg-size = <0x8000>;
				record-size = <0x8000>;
			};

			cp-mem@89600000 {
				phandle = <0x170>;
				reg = <0x00 0x89600000 0x00 0x4900000>;
			};

			rebootescrow@0xfff70000 {
				no-map;
				reg = <0x00 0xfff70000 0x00 0x10000>;
			};

			audiodsp-mem@89000000 {
				phandle = <0xa6>;
				reg = <0x00 0x89000000 0x00 0x600000>;
			};

			cma_share@f00000000 {
				reusable;
				phandle = <0x176>;
				reg = <0x00 0xf0000000 0x00 0x3000000>;
				compatible = "shared-dma-pool";
				linux,cma-default;
			};

			widevine@e3800000 {
				phandle = <0x192>;
				reg = <0x00 0xe3800000 0x00 0xc800000>;
			};

			audio-mem@87400000 {
				phandle = <0xa5>;
