					compatible = "sprd,pubcp-dvfs";
					sprd,devices-name = "core_axi";
					sprd,devices-num = <0x01>;
				};

				channel@2 {
					sprd,tx-blknum = <0x40>;
					phandle = <0x143>;
					reg = <0x02>;
					sprd,rx-blknum = <0x40>;
					compatible = "sprd,spool";
					sprd,tx-blksize = <0x5f4>;
					label = "imsbr_data";
					sprd,rx-blksize = <0x5f4>;
				};

				channel@30 {
					phandle = <0x155>;
					reg = <0x1e>;
					sprd,router = <0xa2>;
					compatible = "sprd,seth";
					sprd,blknum = <0x100>;
				};

				channel@20 {
					phandle = <0x14e>;
					reg = <0x14>;
					sprd,router = <0xa2>;
					compatible = "sprd,seth";
					sprd,blknum = <0x100>;
				};

				channel@9 {
					phandle = <0x14b>;
					reg = <0x09>;
					sprd,router = <0xa2>;
					compatible = "sprd,seth";
					sprd,blknum = <0x100>;
				};

				channel@29 {
					phandle = <0x154>;
					reg = <0x1d>;
					sprd,router = <0xa2>;
					compatible = "sprd,seth";
					sprd,blknum = <0x100>;
				};

				channel@19 {
					phandle = <0x14d>;
					reg = <0x13>;
					sprd,router = <0xa2>;
					compatible = "sprd,seth";
					sprd,blknum = <0x100>;
				};

				channel@7 {
					phandle = <0x149>;
					reg = <0x07>;
					sprd,router = <0xa2>;
					compatible = "sprd,seth";
					sprd,blknum = <0x100>;
				};

				channel@27 {
					phandle = <0x152>;
					reg = <0x1b>;
					sprd,router = <0xa2>;
					compatible = "sprd,seth";
					sprd,blknum = <0x100>;
				};

				channel@5 {
					sprd,tx-blknum = <0x00>;
					phandle = <0x148>;
					reg = <0x05>;
					sprd,rx-blknum = <0x100>;
					compatible = "sprd,spool";
					sprd,tx-blksize = <0x00>;
